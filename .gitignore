node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Secrets. Nothing here may ever be committed.
.env
.env.*
!.env.example

# Regenerated by `next dev` and `next build`, which rewrite the routes reference
# to point at .next/dev or .next depending on which one ran last. Committed, it
# produces a spurious one-line diff every time a developer switches between
# running the dev stack and building — noise that trains people to `git add -A`
# past it.
#
# Next's own documentation says to commit this file. Ignoring it is safe here
# because it is not load-bearing for us: `tsc` was checked against a simulated
# fresh clone with the file absent AND no .next directory, and passed. Next
# regenerates it on the first dev or build in any case.
apps/web/next-env.d.ts

# Site-specific Compose overrides. DEPLOYMENT.md §6 tells operators to create
# this from docker-compose.native-enc.example.yml; it carries host paths and
# hostnames and must not come back here.
docker-compose.override.yml
docker-compose.override.yaml
*.pem
*.key
*.crt
# Live PuppetDB mTLS material. The directory is tracked only for its README,
# so the layout is documented without any key ever being committable.
certs/*
!certs/README.md
# The OpenVox estate's client certificate and key. Same rule as certs/:
# key material never reaches the repository, whatever the estate.
certs-openvox/

# ADR-0002: the private enterprise layer is fetched by scripts/enterprise.mjs
# from NEXUSPUPPET_ENTERPRISE_REPO. It is never committed here, and this
# repository contains no reference to its location.
packages/enterprise/

# Fixtures may contain real hostnames and facts from a customer estate.
# Commit only anonymized samples, explicitly un-ignored.
fixtures/*
!fixtures/.gitkeep
!fixtures/README.md
!fixtures/*.sample.json

# Materialized ENC output — generated, never source of truth.
enc-output/

.DS_Store
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json
playwright-report/
test-results/

# Prisma generated client (regenerate with `npm run db:generate`).
apps/api/src/generated/

# Throwaway dev certificates, generated on first run of scripts/dev/puppetdb.mjs
scripts/dev/certs/

# Playwright artefacts
e2e/.results/
e2e/.logs/
playwright-report/

# Test/site certificates for the optional TLS proxy (ADR-0013). Certificates
# are mounted from a path the operator chooses; nothing here belongs in git.
deploy/caddy/certs/

# QA fuzzer output: screenshots and a crash report per run.
qa-report/
