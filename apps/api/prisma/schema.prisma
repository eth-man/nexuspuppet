// NexusPuppet — local application state only.
//
// PuppetDB remains authoritative for facts, catalogs, and reports (ADR-0004).
// Nothing in this schema duplicates it except ManagedNode, which is an
// explicitly disposable cache.
//
// The EncMaterializationJob table is the transactional outbox that makes
// ADR-0003 ("generate, don't serve") safe: a classification change and its
// materialization job are written in ONE transaction, so a committed change can
// never be silently lost between the database and the disk.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from this block. The connection string for migration
// and introspection commands now lives in ../prisma.config.ts, and the runtime
// client receives a driver adapter explicitly. See ADR-0005.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & access (ADR-0006)
// ---------------------------------------------------------------------------

/// A named set of permissions (ADR-0018).
///
/// Added ahead of the resolution change on purpose. This migration is purely
/// additive: the table is created, the three built-ins are seeded to exactly the
/// sets `ROLE_PERMISSIONS` grants today, and every user is pointed at the row
/// matching the enum they already have.
///
/// That was written while nothing read `roleId`. Plenty does now — the user
/// counts on the Roles screen, the last-administrator guard, and the check that
/// refuses to delete a role somebody still holds all count through the key,
/// while the console displays the name. Anything that writes one and not the
/// other makes those two disagree, and the disagreement is silent.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Matches the UserRole enum for the seeded rows, so a mapping or a runbook
  /// naming "ADMIN" keeps meaning the same thing after the enum goes away.
  name        String   @unique @db.VarChar(64)
  description String?
  /// Permission strings from `permissionSchema` in @nexuspuppet/contracts.
  /// Not an enum: a Postgres enum would need a migration per permission added,
  /// and the authoritative list is the Zod schema the API validates against.
  permissions String[]
  /// Seeded by the product rather than created by an operator. Not deletable
  /// and not renamable — the names appear in directory role mappings, in audit
  /// history, and in other people's runbooks.
  builtIn     Boolean  @default(false)

  users User[]

  @@map("roles")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Normalised to lowercase on write. Plain text rather than citext so the
  /// schema needs no Postgres extension at migrate time.
  email               String    @unique
  displayName         String
  /// scrypt$N$r$p$salt$hash — self-describing so parameters can be raised
  /// later and verified per-record. Null when an external directory owns
  /// authentication (enterprise LDAP/SAML).
  passwordHash        String?
  /// The role's NAME, denormalised (ADR-0018).
  ///
  /// No longer an enum: a deployment may define its own roles, and this has to
  /// be able to hold one. It stays in lockstep with roleId, which is the
  /// authoritative link — this column exists so a user list can be rendered
  /// without a join, and dropping it is a separate change.
  role                String    @default("VIEWER")
  /// Required now that authorization resolves through it (ADR-0018).
  ///
  /// onDelete: Restrict is what stops a role being deleted while somebody holds
  /// it. The alternative — cascade — would delete the users, and SetNull would
  /// leave accounts that authenticate and are denied everything.
  roleId              String    @db.Uuid
  roleRef             Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive            Boolean   @default(true)
  /// Identifier of the auth provider that owns this account.
  authSource          String    @default("local")
  lastLoginAt         DateTime?
  /// Consecutive failed password attempts. Reset to zero on success.
  ///
  /// Persisted rather than held in memory because an in-memory counter is
  /// per-replica: an attacker simply spreads attempts across replicas and the
  /// threshold is never reached on any one of them.
  failedLoginAttempts Int       @default(0)
  /// Set when the threshold is crossed; the account refuses passwords until it
  /// passes. Null means not locked. Time-boxed on purpose — a permanent lock
  /// turns a guessable email address into a denial of service against a real
  /// person, with no way back that does not involve an administrator.
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  savedQueries  SavedQuery[]

  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token. The plaintext is never stored.
  tokenHash  String    @unique
  /// Rotation family. Reuse of a consumed token revokes the entire family.
  familyId   String    @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Node projection — a CACHE of PuppetDB, never a source of truth (ADR-0004)
// ---------------------------------------------------------------------------

/// Safe to truncate. Rebuilt by NodeProjectionService.
///
/// Exists so rule evaluation during materialization reads Postgres rather than
/// PuppetDB — otherwise a PuppetDB outage would block classification changes,
/// reintroducing exactly the coupling ADR-0003 removes.
model ManagedNode {
  certname           String    @id @db.VarChar(255)
  environment        String?
  /// The PROJECTED fact subset (an allow-list), not the full fact blob.
  /// Full facts are unbounded; mirroring them here would be a large, useless table.
  facts              Json      @default("{}")
  latestReportStatus String?
  reportTimestamp    DateTime?
  factsTimestamp     DateTime?
  expired            Boolean   @default(false)
  /// PuppetDB has deactivated this node but has NOT purged it.
  ///
  /// Two different states, and only one is permanent: a deactivated node
  /// returns simply by checking in again. Its classification is therefore
  /// retained rather than deleted, and PuppetDB's node-purge-ttl remains the
  /// only signal that a node is genuinely gone. Inventing a second, local
  /// notion of "gone" would mean two systems disagreeing about node lifecycle.
  ///
  /// Retained but not re-materialized: the file stays, the churn does not.
  deactivated        Boolean   @default(false)
  /// When this row was last refreshed from PuppetDB. Surfaced in the UI as
  /// "facts as of <t>" so operators can see staleness rather than guess at it.
  projectedAt        DateTime  @default(now())

  materialization EncMaterialization?

  @@index([environment])
  @@index([projectedAt])
  @@index([latestReportStatus])
  @@map("managed_nodes")
}

// ---------------------------------------------------------------------------
// Classification (ADR-0009)
// ---------------------------------------------------------------------------

enum MatchStrategy {
  ALL_RULES
  ANY_RULE
  PINNED
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  MATCHES_REGEX
  NOT_MATCHES_REGEX
  IN
  NOT_IN
  GREATER_THAN
  LESS_THAN
  EXISTS
  NOT_EXISTS
}

model NodeGroup {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  description String?
  /// Higher rank is applied LATER and therefore wins on conflict.
  /// Ties are broken by id so merge order is fully deterministic (ADR-0009).
  rank        Int           @default(100)
  strategy    MatchStrategy @default(ALL_RULES)
  /// Sets the ENC `environment` key. Null does not clear an earlier value.
  environment String?
  isEnabled   Boolean       @default(true)

  /// Hierarchy contributes ordering, not value inheritance: a child is always
  /// evaluated after its ancestors and therefore overrides them.
  parentId String?     @db.Uuid
  parent   NodeGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children NodeGroup[] @relation("GroupHierarchy")

  rules      NodeGroupRule[]
  classes    NodeGroupClass[]
  parameters NodeGroupParameter[]
  pins       NodeGroupPin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rank, id])
  @@index([parentId])
  @@index([isEnabled])
  @@map("node_groups")
}

model NodeGroupRule {
  id        String       @id @default(uuid()) @db.Uuid
  groupId   String       @db.Uuid
  group     NodeGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Dotted path into the projected fact subset, e.g. `os.family`.
  /// A path outside the projected allow-list can never match; the UI must warn
  /// rather than silently never matching.
  factPath  String       @db.VarChar(512)
  operator  RuleOperator
  /// Absent for EXISTS / NOT_EXISTS.
  value     Json?
  createdAt DateTime     @default(now())

  @@index([groupId])
  @@map("node_group_rules")
}

/// Explicit static membership, used with MatchStrategy.PINNED.
model NodeGroupPin {
  groupId   String    @db.Uuid
  group     NodeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Deliberately a PLAIN COLUMN with no foreign key to ManagedNode.
  ///
  /// Pinning a node that has not yet checked in is a legitimate operation — it
  /// may be provisioned tomorrow — and ManagedNode is an explicitly disposable
  /// cache (ADR-0004) that must be truncatable without dropping operator
  /// intent. A foreign key here would forbid both.
  certname  String    @db.VarChar(255)
  createdAt DateTime  @default(now())

  @@id([groupId, certname])
  @@index([certname])
  @@map("node_group_pins")
}

model NodeGroupClass {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  group     NodeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Validated against Puppet's identifier grammar before persistence — an
  /// invalid class name is rejected in the UI, not discovered during catalog
  /// compilation.
  className String    @db.VarChar(255)
  /// Parameter map. Values are replaced wholesale on conflict, never
  /// deep-merged (ADR-0009).
  params    Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([groupId, className])
  @@index([className])
  @@map("node_group_classes")
}

/// Top-scope ENC parameters contributed by a group.
model NodeGroupParameter {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  group     NodeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  key       String    @db.VarChar(255)
  value     Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([groupId, key])
  @@map("node_group_parameters")
}

// ---------------------------------------------------------------------------
// Materialization — the machinery that makes ADR-0003 work
// ---------------------------------------------------------------------------

/// What a materialization job is asking for.
///
/// Explicit rather than inferred from a missing ManagedNode: a node that
/// re-registers between enqueue and drain would otherwise be silently deleted,
/// because the absence that justified the job no longer holds by the time it
/// runs.
enum EncJobKind {
  MATERIALIZE
  DELETE
}

enum MaterializationStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

/// THE TRANSACTIONAL OUTBOX.
///
/// Written in the SAME transaction as the classification change that caused it.
/// Either both land or neither does, so a crash between commit and file write
/// loses nothing — the job is still PENDING on restart.
model EncMaterializationJob {
  id            String                @id @default(uuid()) @db.Uuid
  /// Null means a full reconcile of every node.
  certname      String?               @db.VarChar(255)
  /// Whether to write this node's file or remove it.
  kind          EncJobKind            @default(MATERIALIZE)
  /// Collapses redundant work: many edits to one group before the worker runs
  /// should produce one materialization, not N. Upserted on this key.
  dedupeKey     String                @unique
  reason        String                @db.VarChar(255)
  status        MaterializationStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?
  /// Exponential backoff; the worker ignores jobs until this instant.
  nextAttemptAt DateTime              @default(now())
  /// How far a full reconcile has progressed: the last certname written.
  ///
  /// A full reconcile touches every node in the estate, which at ten thousand
  /// nodes is ten thousand file writes inside one job. Processing it in
  /// bounded chunks and re-enqueueing with this cursor keeps each batch — and
  /// so the advisory lock and its transaction — short regardless of estate
  /// size, and makes the reconcile resumable rather than all-or-nothing.
  ///
  /// Null on a per-node job, and on a full reconcile that has not started.
  cursor        String?               @db.VarChar(255)
  createdAt     DateTime              @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([certname])
  @@map("enc_materialization_jobs")
}

/// What is currently believed to be on disk for a node.
///
/// contentHash drives change detection: identical rendered YAML must not
/// rewrite the file, which is why EncYamlRenderer is required to be
/// deterministic down to key ordering (ADR-0009).
model EncMaterialization {
  certname        String      @id @db.VarChar(255)
  node            ManagedNode @relation(fields: [certname], references: [certname], onDelete: Cascade)
  /// SHA-256 of the rendered YAML.
  contentHash     String      @db.VarChar(64)
  /// Monotonic per node; increments only when content actually changes.
  revision        Int         @default(1)
  /// Path relative to ENC_OUTPUT_DIR, e.g. `nodes/web01.example.com.yaml`.
  relativePath    String
  /// Groups applied, in merge order. Answers "why is this node classified this way?"
  appliedGroupIds String[]    @db.Uuid
  /// Conflicts detected during merge. Warnings, not errors — surfaced in the UI (ADR-0009).
  conflicts       Json        @default("[]")
  writtenAt       DateTime    @default(now())

  @@index([writtenAt])
  @@index([contentHash])
  @@map("enc_materializations")
}

// ---------------------------------------------------------------------------
// Audit, settings, saved views
// ---------------------------------------------------------------------------

/// Written inside the same transaction as the change it records (ADR-0005).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Denormalised so the record survives user deletion.
  actorEmail  String?
  action      String   @db.VarChar(128)
  entityType  String   @db.VarChar(64)
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  deliveryJob AuditDeliveryJob?

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Outbox for forwarding an audit record to an external system (ADR-0005).
///
/// A SIEM sink cannot take part in the transaction that produced the record:
/// doing HTTP inside `prisma.$transaction` holds a connection and its locks open
/// for the duration of a network call, and a rollback would leave the SIEM told
/// about a change that never happened.
///
/// So delivery is decoupled the same way ENC materialization is. The row is
/// written in the SAME transaction as the change and its audit record; a worker
/// drains it afterwards. There is no committed change without a queued delivery.
///
/// Core writes nothing here unless a capability that forwards audit records is
/// installed. The table exists in core because only core owns the schema —
/// the enterprise layer cannot add a migration.
model AuditDeliveryJob {
  id         String   @id @default(uuid()) @db.Uuid
  /// Cascades: if audit retention removes the record, an undelivered job for it
  /// is meaningless. Forwarding is best-effort against a retention window.
  auditLogId String   @unique @db.Uuid
  auditLog   AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  attempts      Int      @default(0)
  /// Claim-by-delete needs a schedule so a failed attempt backs off rather than
  /// spinning. A row is only visible to a worker once this passes.
  nextAttemptAt DateTime @default(now())
  /// Kept for the operator, not for the retry logic.
  lastError     String?
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt])
  @@map("audit_delivery_jobs")
}

/// Configuration an operator can change from the console (ADR-0016).
///
/// One row per kind — `auth.ldap`, `audit.syslog`, `audit.webhook` — because a
/// deployment reads a configuration entirely from here or entirely from the
/// environment. Merging the two per field produces a state nobody can reproduce
/// from either source.
///
/// Deliberately NOT the generic AppSetting key/value table. Secrets need a
/// column of their own so that a careless select, a generic settings endpoint
/// or a debug log cannot carry them; a shared JSON blob makes that a matter of
/// remembering rather than of structure.
model ProviderSetting {
  /// The configuration this row owns. One row per kind, enforced by the key.
  kind String @id @db.VarChar(64)

  /// Non-secret configuration: URLs, search bases, role mappings, ports. Safe
  /// to render in a browser and safe to log.
  config Json

  /// Secret fields, encrypted with CONFIG_ENCRYPTION_KEY and NEVER returned by
  /// any read endpoint (ADR-0016 §3). Bytes rather than Json so it cannot be
  /// spread into a response by accident — a ciphertext blob has no fields to
  /// pick up.
  secrets Bytes?

  /// A stored configuration that is present but switched off. Distinct from an
  /// absent row: absent falls back to the environment, disabled does not.
  enabled Boolean @default(true)

  updatedAt      DateTime @updatedAt
  /// Denormalised like AuditLog.actorEmail, so "who last changed this" survives
  /// the deletion of the account that changed it.
  updatedByEmail String?

  @@map("provider_settings")
}

model AppSetting {
  key       String   @id @db.VarChar(128)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model SavedQuery {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// A typed NodeFilter, never a raw PQL string (ADR-0004).
  filter    Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("saved_queries")
}

/// A puppetserver that pulls the ENC tree for replication (ADR-0019 §6).
///
/// One row per puller, updated in place rather than appended per fetch. Most
/// polls are unchanged 304s, so an append-only log would grow without bound to
/// record that nothing happened. What the console needs is "did classification
/// reach the server, and when" — which is the LAST fetch, not every fetch.
model EncReplicationPeer {
  /// The certname from the client certificate, verified against the Puppet CA.
  /// Never taken from a header or a query parameter.
  certname      String    @id @db.VarChar(255)
  firstSeenAt   DateTime  @default(now())
  lastFetchAt   DateTime
  /// The tree revision this peer last received. Matches the ETag served.
  lastEtag      String    @db.VarChar(64)
  /// 200 when a tree was transferred, 304 when the peer was already current.
  /// Both prove reachability; only 200 proves data moved.
  lastStatus    Int
  /// Last 200 specifically. A peer stuck on 304 with an old lastChangedAt is
  /// healthy; one that has never had a 200 has never received anything.
  lastChangedAt DateTime?
  fetchCount    Int       @default(0)

  @@index([lastFetchAt])
  @@map("enc_replication_peers")
}
