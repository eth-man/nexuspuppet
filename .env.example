# NexusPuppet configuration.
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# Never paste real certificates or secrets into the repository, an issue, or a
# chat window — treat anything that lands in one of those as compromised.

# --- Core ------------------------------------------------------------------
# docker-compose.yml passes THIS ENTIRE FILE to the api container, so anything
# set here reaches the service. The handful of keys Compose has to override for
# the container to work at all are marked "Compose overrides" below; setting one
# of those here affects a non-Compose run only.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
# The level the API STARTS at. An administrator can change it from Settings →
# General without a restart, and that stored choice then wins — which is the
# point: raising the level to debug is something you need during an incident,
# and a restart is the one thing you cannot do then.
#
# SETTINGS_SOURCE=env makes this authoritative again and the console control
# inert, which the console says out loud.
LOG_LEVEL=info

# --- Docker Compose --------------------------------------------------------
# Read by docker-compose.yml, which fails fast rather than defaulting a
# database password. Compose loads this file automatically from the project
# directory, so `docker compose build` needs them present even though it does
# not start anything.
POSTGRES_USER=nexuspuppet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexuspuppet
# Directory holding client.pem / client.key / ca.pem, mounted read-only.
PUPPETDB_CERT_DIR=./certs
#
# Which host address the published ports bind to. LOOPBACK BY DEFAULT: neither
# service terminates TLS, so until the reverse proxy in DEPLOYMENT.md is in
# front of them, publishing on 0.0.0.0 carries login credentials in cleartext.
# Set these to 0.0.0.0 only when something else is handling TLS, or when the
# host is not reachable from an untrusted network.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# --- TLS for the console (ADR-0013, DEPLOYMENT.md §7) ----------------------
# Only used by the optional `tls` Compose profile:
#
#   docker compose --profile tls up -d
#
# Leave these alone if you terminate TLS at your own reverse proxy.
#
# CONSOLE_HOSTNAME must be the name on the certificate AND the name people type
# into the browser. A certificate for the host's FQDN does not help someone
# reaching the console by IP.
# CONSOLE_HOSTNAME=console.example.com
#
# A directory containing console.pem and console.key, mounted read-only into the
# proxy and NOTHING else. The private key is never uploaded through the app,
# never stored in Postgres, and never read by the api or web services.
#
# Deliberately NOT the same directory as PUPPETDB_CERT_DIR above. That one is
# mounted into the api; this one is not, and keeping them apart is what stops
# the api from ever being able to open a TLS key.
#
#   sudo install -d -m 0755 -o 0 -g 0 /etc/nexuspuppet/tls
#   console.pem  0444 root:root   (public — world-readable is correct)
#   console.key  0400 root:root   (only the proxy reads this)
# CONSOLE_TLS_DIR=/etc/nexuspuppet/tls
#
# The proxy publishes these on all interfaces by design — it is the only service
# here that terminates TLS.
# HTTPS_PORT=443
# HTTP_PORT=80
#
# Reporting only, and independent of the profile above: point this at the PUBLIC
# certificate and Settings shows its subject, the names it covers, and how many
# days are left. Set it whatever terminates TLS — the bundled proxy, your nginx,
# an appliance — because the API reads a file and never asks a proxy anything.
#
# Mount the SINGLE .pem into the api container, never the directory holding the
# key. The api has no reason to be able to read a private key.
#
# The certificate is 0444, so this works whatever uid the api runs as — the
# ownership problem in §3 does not arise for public material.
# CONSOLE_TLS_CERT_PATH=/etc/nexuspuppet/console.pem

# --- Database (ADR-0005) ---------------------------------------------------
# Compose overrides: inside the network the host is the `db` service, not
# localhost. This value is for running the API directly on the host.
DATABASE_URL=postgresql://nexuspuppet:change-me@localhost:5432/nexuspuppet?schema=public

# Only needed to run `prisma migrate diff --from-migrations` (the CI drift
# check). Prisma may drop and recreate this database, so keep it separate.
# SHADOW_DATABASE_URL=postgresql://nexuspuppet:change-me@localhost:5432/nexuspuppet_shadow?schema=public

# --- Auth (ADR-0006) -------------------------------------------------------
# No default, deliberately. The API refuses to boot without it — a development
# fallback secret is exactly the kind of thing that reaches production.
# Generate: openssl rand -base64 48
JWT_SECRET=
# How long a session lasts is REFRESH_TOKEN_TTL, not ACCESS_TOKEN_TTL. The
# console silently exchanges the refresh token for a new access token whenever
# one expires, so an operator stays signed in for 30 days without noticing the
# 60-minute access token underneath.
#
# That exchange was broken until it was measured: the browser drops the access
# cookie at its expiry, so the next request carried no token, and the client
# only refreshed on the API's TOKEN_EXPIRED code — which needs a token to be
# produced at all. Operators were bounced to the login screen every access-token
# lifetime with a valid 30-day refresh cookie in the jar.
#
# Raising ACCESS_TOKEN_TTL is therefore the wrong lever for "I keep getting
# logged out". It buys nothing once refresh works, and it costs: the principal
# is rebuilt from token claims rather than a per-request database read, so a
# role change or a deactivation only takes effect when the access token next
# expires. At 12h a revoked admin keeps admin for up to twelve hours.
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=30d

# Encrypts settings stored through the console (ADR-0016). OPTIONAL: a
# deployment configured entirely from this file stores no secrets and needs no
# key. Set it before saving a credential through the UI.
#
# NOT the same value as JWT_SECRET, deliberately. One key, one purpose —
# rotating a signing secret must not decide whether stored credentials stay
# readable, and a key compromised in one role must not surrender the other.
#
# Generate: openssl rand -base64 32   (must decode to 32 BYTES, not 32 characters)
# CONFIG_ENCRYPTION_KEY=
#
# Ignore stored settings and read everything from this file. The escape hatch:
# without it, a configuration saved through the console that does not work
# leaves an operator unable to authenticate AND unable to override it.
# SETTINGS_SOURCE=env

# Local account lockout (ADR-0006). Complements the in-memory rate limiter,
# which is per-replica and per-minute and so never accumulates.
# Set LOGIN_MAX_FAILED_ATTEMPTS=0 to disable lockout entirely.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Seeds the first admin on an empty database. Remove after first boot.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- PuppetDB (ADR-0004) ---------------------------------------------------
# Read-only. mTLS. Paths to MOUNTED FILES, never inline PEM content.
PUPPETDB_URL=https://puppetdb.example.com:8081
#
# Compose overrides: it mounts PUPPETDB_CERT_DIR at this path read-only and
# sets these three itself, so changing them here affects a non-Compose run only.
PUPPETDB_CERT_PATH=/etc/nexuspuppet/certs/client.pem
PUPPETDB_KEY_PATH=/etc/nexuspuppet/certs/client.key
PUPPETDB_CA_PATH=/etc/nexuspuppet/certs/ca.pem
#
# For COMMISSIONING from a development machine, point these at the repo's
# gitignored certs/ directory instead and prove the connection with
# `npm run test:puppetdb` before deploying anything. See certs/README.md.
#
#   PUPPETDB_CERT_PATH=./certs/client.pem
#   PUPPETDB_KEY_PATH=./certs/client.key
#   PUPPETDB_CA_PATH=./certs/ca.pem
PUPPETDB_TIMEOUT_MS=10000

# Facts projected into ManagedNode for rule evaluation. An allow-list, not the
# full fact blob — full facts are unbounded. A rule referencing a fact outside
# this list can never match.
#
# TOP-LEVEL FACT NAMES ONLY. This selects which facts are FETCHED; a rule then
# addresses inside them with a dotted path. So `networking` belongs here and
# `networking.fqdn` does not — putting the dotted form in this list fetches
# nothing, and every rule using it silently matches nothing.
#
# That distinction is where Facter 4 catches people out, because the flat facts
# it dropped are exactly the ones operators reach for first:
#
#   fqdn, hostname   ->  under `networking`  (networking.fqdn, networking.hostname)
#   manufacturer     ->  under `dmi`         (dmi.manufacturer)
#   productname      ->  under `dmi`         (dmi.product.name)
#   serialnumber     ->  under `dmi`         (dmi.product.serial_number)
#   uptime           ->  the fact is `system_uptime` (system_uptime.uptime)
#
# `environment` is NOT a fact. PuppetDB carries it as a node property and the
# console shows it as its own column; naming it here does nothing.
#
# The default below is deliberately broad: the standard Facter facts a rule is
# likely to touch, plus the organizational names operators conventionally supply
# from their own modules — role, profile, tier, datacenter, location,
# application, tenant, cluster. Those cost nothing on an estate that does not
# report them, and having them present means classification works out of the box
# where they are. The projector names any that go unreported, so their absence is
# stated rather than silent.
#
# Weigh size before adding more. Facts are stored per node, so a large blob is
# multiplied by the estate. `ssh` is the cautionary one — around 1.4 kB a node of
# host keys that nobody writes rules against, which is why it is not here.
#
# The projector logs any name here that no node reports, and `npm run
# test:puppetdb` flags them against a sampled node.
PUPPETDB_PROJECTED_FACTS=role,profile,tier,datacenter,location,application,tenant,cluster,trusted,clientcert,fips_enabled,os,kernel,kernelrelease,timezone,system_uptime,networking,processors,memory,virtual,is_virtual,dmi,disks
PUPPETDB_PROJECTION_INTERVAL_MS=300000

# How often to ask which nodes' facts changed, and how far back to overlap.
# Outbound polling only — nothing is exposed for puppetserver to call, so a
# slow or absent NexusPuppet cannot affect an agent run (ADR-0003).
# Set PUPPETDB_POLL_INTERVAL_MS=0 to rely on the full sweep alone.
PUPPETDB_POLL_INTERVAL_MS=30000
PUPPETDB_POLL_OVERLAP_MS=120000

# --- ENC materialization (ADR-0003) ----------------------------------------
# Mounted read-write here, READ-ONLY in puppetserver. Only this app writes it.
# Compose overrides: this is the mount point of the enc-data volume. For local
# development use a writable relative path, e.g. ENC_OUTPUT_DIR=./enc-output
# (gitignored).
ENC_OUTPUT_DIR=/srv/nexuspuppet/enc

# ---------------------------------------------------------------------------
# ENC tree replication (ADR-0019)
# ---------------------------------------------------------------------------
#
# Only needed when puppetserver runs on a DIFFERENT HOST. If it shares this
# host and reads the ENC volume through a mount, leave this off — you already
# have the tree.
#
# When on, NexusPuppet serves the materialized tree over mTLS and a small
# systemd timer on the Puppet server pulls it. The compile path is unchanged:
# the ENC script still reads a local file, so NexusPuppet being down leaves the
# last synced tree in place and agents keep converging. That property is the
# whole point, and nothing here may compromise it.
ENC_REPLICATION_ENABLED=false

# The certnames permitted to fetch, comma separated.
#
# THERE IS NO DEFAULT AND AN EMPTY LIST SERVES NOBODY. The Puppet CA signs
# every agent in the estate, so a valid client certificate proves only that the
# caller is part of the estate — it does not make them entitled to read how the
# whole estate is classified. This list is the control.
#
#   ENC_REPLICATION_ALLOWED_CERTNAMES=puppet.corp.local
ENC_REPLICATION_ALLOWED_CERTNAMES=

# Where it listens. Binds every interface by default, unlike API_BIND, because
# this listener terminates mTLS itself and the puller is on another host.
ENC_REPLICATION_PORT=8443
ENC_REPLICATION_BIND=0.0.0.0

# Served with the PuppetDB client certificate, and verifies pullers against the
# same Puppet CA. Overridden in docker-compose.yml to the container mount
# points; set these only for a non-Docker deployment.
#ENC_REPLICATION_CERT_PATH=/etc/nexuspuppet/certs/client.pem
#ENC_REPLICATION_KEY_PATH=/etc/nexuspuppet/certs/client.key
#ENC_REPLICATION_CA_PATH=/etc/nexuspuppet/certs/ca.pem
ENC_DEFAULT_ENVIRONMENT=production
ENC_MATERIALIZER_INTERVAL_MS=2000
ENC_RECONCILE_INTERVAL_MS=900000
ENC_MAX_JOB_ATTEMPTS=5

# Materializer pacing. A single rule change can enqueue work for every node;
# unpaced that is thousands of fsyncs in one burst on a disk shared with
# Postgres. Lower the batch size or raise the delay if the estate is large or
# the storage is slow.
ENC_MATERIALIZER_BATCH_SIZE=50
ENC_MATERIALIZER_RECONCILE_CHUNK=100
ENC_MATERIALIZER_BATCH_DELAY_MS=100
ENC_MATERIALIZER_MAX_DRAIN_MS=30000

# --- Web -------------------------------------------------------------------
# Server-side only. The browser never receives a PuppetDB or database credential.
API_INTERNAL_URL=http://api:3001

# --- Enterprise layer (ADR-0002) -------------------------------------------
# Leave unset for the core edition. Setting it makes scripts/enterprise.mjs
# clone the private layer into packages/enterprise/. The URL lives here, in an
# ignored file — never in the repository.
# NEXUSPUPPET_ENTERPRISE_REPO=
# NEXUSPUPPET_ENTERPRISE_REF=main

# --- Enterprise licence (ADR-0014) ------------------------------------------
# Where the licence file is mounted. Enterprise only; core ignores it entirely.
#
# A FILE, not the licence itself. A JWT is long, and environment variables leak
# into `docker inspect`, process listings, crash reporters and support bundles —
# mounted files are already the convention here for private keys and PuppetDB
# material.
#
# UNSET IS SAFE. Absent, expired or malformed all behave the same: the API
# starts, enterprise capabilities are not registered, and it says so loudly.
# Classification, materialisation and the ENC are never affected by a licence —
# no billing state may interrupt an estate.
#
# Expiry begins a 30-day grace window rather than a cutoff, because renewals
# cross purchasing departments and time zones.
# NEXUSPUPPET_LICENSE_FILE=/etc/nexuspuppet/licence.jwt

# --- Class suggestions from puppetserver (ADR-0024) -------------------------
# OPTIONAL, and OFF when unset: no client is built, no connection attempted, and
# the class field behaves exactly as it did before this feature existed.
#
# Enabling it needs TWO things. This URL, and an auth.conf rule on the Puppet
# server — the endpoint is denied by default, even to puppetserver's own
# certificate, so without the rule you get 403 and free text.
#
#     {
#         match-request: {
#             path: "/puppet/v3/environment_classes"
#             type: path
#             method: get
#         }
#         allow: "nexuspuppet.example.com"     # this deployment's certname
#         sort-order: 400
#         name: "nexuspuppet environment classes"
#     }
#
#PUPPETSERVER_URL=https://puppet.example.com:8140

# Make that certname resolve INSIDE the api container, when it does not already.
#
# Needed in two real cases, both found on live hosts:
#
#   - CO-LOCATED on the Puppet server. The host's /etc/hosts maps its own
#     certname to 127.0.1.1; inherited into a container that means the
#     CONTAINER's loopback, where puppetserver is not, so it is refused.
#   - SEPARATE HOSTS with no DNS record for the Puppet server, because
#     PUPPETDB_URL is an IP and nothing ever needed the name.
#
# Set the NAME to an address, not the address in PUPPETSERVER_URL: puppetserver's
# certificate carries DNS SANs only, so connecting by IP fails hostname
# verification instead — trading a resolution problem for a TLS one.
#
# Leave it unset if `getent hosts <certname>` already works inside the container.
#PUPPETSERVER_HOST_ALIAS=puppet.example.com:10.0.0.5

# Default to the PuppetDB client certificate, which is already signed by the
# Puppet CA and already trusted by puppetserver. Nothing new to issue or rotate.
#PUPPETSERVER_CERT_PATH=/etc/nexuspuppet/certs/client.pem
#PUPPETSERVER_KEY_PATH=/etc/nexuspuppet/certs/client.key
#PUPPETSERVER_CA_PATH=/etc/nexuspuppet/certs/ca.pem

# Generous on purpose. Unless `environment-class-cache-enabled: true` is set in
# puppetserver.conf, EVERY fetch reparses the whole environment — minutes on a
# large estate. Foreman's proxy allows up to 300s for the same call.
#PUPPETSERVER_TIMEOUT_MS=120000

# How long a fetched list is served before refetching. The console's Refresh
# button bypasses this, for the operator who has just deployed code.
#PUPPETSERVER_CLASS_CACHE_TTL_MS=300000

# Used when a node group does not set an environment of its own.
#PUPPETSERVER_DEFAULT_ENVIRONMENT=production
