# NexusPuppet configuration.
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# Never paste real certificates or secrets into the repository, an issue, or a
# chat window — treat anything that lands in one of those as compromised.

# --- Core ------------------------------------------------------------------
# docker-compose.yml passes THIS ENTIRE FILE to the api container, so anything
# set here reaches the service. The handful of keys Compose has to override for
# the container to work at all are marked "Compose overrides" below; setting one
# of those here affects a non-Compose run only.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info

# --- Docker Compose --------------------------------------------------------
# Read by docker-compose.yml, which fails fast rather than defaulting a
# database password. Compose loads this file automatically from the project
# directory, so `docker compose build` needs them present even though it does
# not start anything.
POSTGRES_USER=nexuspuppet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexuspuppet
# Directory holding client.pem / client.key / ca.pem, mounted read-only.
PUPPETDB_CERT_DIR=./certs
#
# Which host address the published ports bind to. LOOPBACK BY DEFAULT: neither
# service terminates TLS, so until the reverse proxy in DEPLOYMENT.md is in
# front of them, publishing on 0.0.0.0 carries login credentials in cleartext.
# Set these to 0.0.0.0 only when something else is handling TLS, or when the
# host is not reachable from an untrusted network.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# --- TLS for the console (ADR-0013, DEPLOYMENT.md §7) ----------------------
# Only used by the optional `tls` Compose profile:
#
#   docker compose --profile tls up -d
#
# Leave these alone if you terminate TLS at your own reverse proxy.
#
# CONSOLE_HOSTNAME must be the name on the certificate AND the name people type
# into the browser. A certificate for the host's FQDN does not help someone
# reaching the console by IP.
# CONSOLE_HOSTNAME=console.example.com
#
# A directory containing console.pem and console.key, mounted read-only into the
# proxy and NOTHING else. The private key is never uploaded through the app,
# never stored in Postgres, and never read by the api or web services.
# CONSOLE_TLS_DIR=/etc/nexuspuppet/tls
#
# The proxy publishes these on all interfaces by design — it is the only service
# here that terminates TLS.
# HTTPS_PORT=443
# HTTP_PORT=80

# --- Database (ADR-0005) ---------------------------------------------------
# Compose overrides: inside the network the host is the `db` service, not
# localhost. This value is for running the API directly on the host.
DATABASE_URL=postgresql://nexuspuppet:change-me@localhost:5432/nexuspuppet?schema=public

# Only needed to run `prisma migrate diff --from-migrations` (the CI drift
# check). Prisma may drop and recreate this database, so keep it separate.
# SHADOW_DATABASE_URL=postgresql://nexuspuppet:change-me@localhost:5432/nexuspuppet_shadow?schema=public

# --- Auth (ADR-0006) -------------------------------------------------------
# No default, deliberately. The API refuses to boot without it — a development
# fallback secret is exactly the kind of thing that reaches production.
# Generate: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Local account lockout (ADR-0006). Complements the in-memory rate limiter,
# which is per-replica and per-minute and so never accumulates.
# Set LOGIN_MAX_FAILED_ATTEMPTS=0 to disable lockout entirely.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Seeds the first admin on an empty database. Remove after first boot.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- PuppetDB (ADR-0004) ---------------------------------------------------
# Read-only. mTLS. Paths to MOUNTED FILES, never inline PEM content.
PUPPETDB_URL=https://puppetdb.example.com:8081
#
# Compose overrides: it mounts PUPPETDB_CERT_DIR at this path read-only and
# sets these three itself, so changing them here affects a non-Compose run only.
PUPPETDB_CERT_PATH=/etc/nexuspuppet/certs/client.pem
PUPPETDB_KEY_PATH=/etc/nexuspuppet/certs/client.key
PUPPETDB_CA_PATH=/etc/nexuspuppet/certs/ca.pem
#
# For COMMISSIONING from a development machine, point these at the repo's
# gitignored certs/ directory instead and prove the connection with
# `npm run test:puppetdb` before deploying anything. See certs/README.md.
#
#   PUPPETDB_CERT_PATH=./certs/client.pem
#   PUPPETDB_KEY_PATH=./certs/client.key
#   PUPPETDB_CA_PATH=./certs/ca.pem
PUPPETDB_TIMEOUT_MS=10000

# Facts projected into ManagedNode for rule evaluation. An allow-list, not the
# full fact blob — full facts are unbounded. A rule referencing a fact outside
# this list can never match.
# Add your estate's OWN custom facts here — `role`, `profile`, `tier` and the
# like are what operators actually write rules against. Add the ones YOUR nodes
# report: a name nothing reports makes every rule on it silently unmatchable.
#
# Facter 4 dropped the legacy flat facts, so `fqdn` and `domain` are NOT in this
# default — they exist only under `networking`, and `networking.fqdn` resolves on
# every supported estate. `role` is not a Facter fact at all; add it only if your
# own module supplies it.
#
# The projector logs any name here that no node reports, and `npm run
# test:puppetdb` flags them against a sampled node.
PUPPETDB_PROJECTED_FACTS=os,networking,processors,memory,virtual,is_virtual,kernel
PUPPETDB_PROJECTION_INTERVAL_MS=300000

# How often to ask which nodes' facts changed, and how far back to overlap.
# Outbound polling only — nothing is exposed for puppetserver to call, so a
# slow or absent NexusPuppet cannot affect an agent run (ADR-0003).
# Set PUPPETDB_POLL_INTERVAL_MS=0 to rely on the full sweep alone.
PUPPETDB_POLL_INTERVAL_MS=30000
PUPPETDB_POLL_OVERLAP_MS=120000

# --- ENC materialization (ADR-0003) ----------------------------------------
# Mounted read-write here, READ-ONLY in puppetserver. Only this app writes it.
# Compose overrides: this is the mount point of the enc-data volume. For local
# development use a writable relative path, e.g. ENC_OUTPUT_DIR=./enc-output
# (gitignored).
ENC_OUTPUT_DIR=/srv/nexuspuppet/enc
ENC_DEFAULT_ENVIRONMENT=production
ENC_MATERIALIZER_INTERVAL_MS=2000
ENC_RECONCILE_INTERVAL_MS=900000
ENC_MAX_JOB_ATTEMPTS=5

# Materializer pacing. A single rule change can enqueue work for every node;
# unpaced that is thousands of fsyncs in one burst on a disk shared with
# Postgres. Lower the batch size or raise the delay if the estate is large or
# the storage is slow.
ENC_MATERIALIZER_BATCH_SIZE=50
ENC_MATERIALIZER_RECONCILE_CHUNK=100
ENC_MATERIALIZER_BATCH_DELAY_MS=100
ENC_MATERIALIZER_MAX_DRAIN_MS=30000

# --- Web -------------------------------------------------------------------
# Server-side only. The browser never receives a PuppetDB or database credential.
API_INTERNAL_URL=http://api:3001

# --- Enterprise layer (ADR-0002) -------------------------------------------
# Leave unset for the core edition. Setting it makes scripts/enterprise.mjs
# clone the private layer into packages/enterprise/. The URL lives here, in an
# ignored file — never in the repository.
# NEXUSPUPPET_ENTERPRISE_REPO=
# NEXUSPUPPET_ENTERPRISE_REF=main
