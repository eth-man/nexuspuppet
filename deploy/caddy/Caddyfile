# TLS termination for the NexusPuppet console (ADR-0013).
#
# Deliberately short. This file is security-relevant configuration an operator
# has to trust, so it should be readable in one sitting.
#
# Started only with the `tls` Compose profile:
#   docker compose --profile tls up -d
#
# CONSOLE_HOSTNAME must be a name the certificate actually carries, and the name
# people type into the browser. A certificate issued for the host's FQDN does not
# help someone reaching the console by IP, and the browser error for that is
# unhelpful.
{
	# Admin API on loopback INSIDE the container only.
	#
	# This endpoint can replace the running configuration, so exposing it is
	# equivalent to handing over TLS termination. It is never published to the
	# host. The API reaches it over the Compose network by container name; see
	# docker-compose.yml, where no port for it is published.
	admin 0.0.0.0:2019

	# No ACME. Certificates come from the operator's own CA and are mounted as
	# files; Caddy must never try to obtain one itself, which is its default
	# behaviour for a public name and would fail confusingly on an internal one.
	auto_https disable_certs

	# Caddy's own log, not the access log below.
	log {
		output stderr
		format console
		level {$CADDY_LOG_LEVEL:INFO}
	}
}

# HTTP: redirect everything to HTTPS, and nothing else.
#
# No content is served here, so an operator who has not finished DNS or firewall
# work cannot accidentally use the console unencrypted and not notice.
http://{$CONSOLE_HOSTNAME} {
	redir https://{host}{uri} permanent
}

https://{$CONSOLE_HOSTNAME} {
	# Read through the `live` symlink, not directly.
	#
	# The certificate and its key must change as a UNIT: two file renames are two
	# moments, and a crash between them leaves a mismatched pair that fails every
	# handshake — on the interface the operator would use to undo it. Swapping one
	# symlink is a single atomic rename (ADR-0017).
	#
	# An upgrade from a deployment that mounted console.pem/console.key directly
	# keeps working: cert-helper adopts them into a set and creates this link on
	# first boot, leaving the originals untouched.
	tls /etc/caddy/certs/live/console.pem /etc/caddy/certs/live/console.key

	# The console is a single upstream. There is no load balancing to do and no
	# second backend to route to — the API is reached through the web tier's
	# server-side relay, never directly from the browser (ADR-0004).
	# Certificate installation goes to the helper, NOT to the api.
	#
	# This is the routing that keeps ADR-0013 §2 literally true: the private key
	# is uploaded by the browser to a component that never shares a process with
	# the API, so it cannot reach the API's heap, logs or crash dumps. The api
	# authorises the upload with a signed grant; it never carries one.
	# Both routes are `handle` blocks, and that is deliberate: handle blocks are
	# mutually exclusive and matched in order, whereas a bare directive alongside
	# them is ordered by Caddy's own directive table rather than by what is
	# written here. Being explicit costs two lines and removes the question.
	handle /console-tls/* {
		reverse_proxy cert-helper:8099
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	# NO HSTS, deliberately. Caddy adds none on its own and none is added here.
	#
	# Strict-Transport-Security is trivial to switch on and painful to switch
	# off: a browser that has seen it refuses plain HTTP to this host for the
	# max-age, whatever the operator does at the server. That turns "let me drop
	# to HTTP for ten minutes to work out why the proxy is routing wrongly" into
	# a per-browser cache-clearing exercise, at exactly the moment nobody has
	# patience for one.
	#
	# It belongs at the edge, where whoever runs it also owns the rollback. To
	# enable it here anyway, uncomment:
	#
	#   header Strict-Transport-Security "max-age=31536000"

	encode zstd gzip

	log {
		output stderr
		format console
	}
}
