# /etc/default/nexuspuppet-receipts
#
# The collector reads /etc/default/nexuspuppet-sync first, so a REPLICATED host
# usually needs nothing here at all — the URL and certificates are already
# configured there and the receipts URL is derived from the tree URL.
#
# A CO-LOCATED host has no sync config, and must set the URL:

# Where to hand receipts. Co-located, this is your own listener on loopback
# (ADR-0022 §14) — the name must match the certificate, so use the certname
# rather than 127.0.0.1.
#NEXUSPUPPET_RECEIPTS_URL=https://puppet.example.com:8443/enc-receipts

# The group puppetserver runs as, which must be able to append to the receipts
# directory. `pe-puppet` on Puppet Enterprise.
#NEXUSPUPPET_RECEIPTS_GROUP=puppet

# Client certificate presented to the origin. Defaults to this node's own agent
# certificate, which a co-located origin already trusts — no new certificate is
# needed for the collector to talk to a NexusPuppet on the same machine.
#NEXUSPUPPET_RECEIPTS_CERTNAME=puppet.example.com

# Oldest-first cap per upload. 0 disables it.
#NEXUSPUPPET_RECEIPTS_MAX=20000
