# /etc/default/nexuspuppet-sync
#
# Read by nexuspuppet-sync.sh and by its systemd unit. Only the first line has
# to be set; everything else is derived from the Puppet server's own layout.

# Where NexusPuppet serves the tree. The host must match the certificate it
# presents, which is the certname NexusPuppet uses for PuppetDB.
NEXUSPUPPET_SYNC_URL=https://nexuspuppet.internal:8443/enc-tree.tar

# --- everything below is optional ---

# This server's own Puppet certificate, used as the client certificate. The
# certname must appear in ENC_REPLICATION_ALLOWED_CERTNAMES on the NexusPuppet
# side or the fetch is refused with 403.
#NEXUSPUPPET_SYNC_CERTNAME=puppet.corp.local
#NEXUSPUPPET_SYNC_SSL_DIR=/etc/puppetlabs/puppet/ssl
#NEXUSPUPPET_SYNC_CERT=/etc/puppetlabs/puppet/ssl/certs/<certname>.pem
#NEXUSPUPPET_SYNC_KEY=/etc/puppetlabs/puppet/ssl/private_keys/<certname>.pem
#NEXUSPUPPET_SYNC_CA=/etc/puppetlabs/puppet/ssl/certs/ca.pem

# The symlink puppetserver reads through. Must match `external_nodes` in
# puppet.conf, or NEXUSPUPPET_ENC_DIR if you set that instead.
#NEXUSPUPPET_SYNC_LINK=/etc/puppetlabs/nexuspuppet
#NEXUSPUPPET_SYNC_STATE_DIR=/var/lib/nexuspuppet-sync

#NEXUSPUPPET_SYNC_TIMEOUT=30
# Previous trees kept for rollback. A rollback is then one `ln -sfn`.
#NEXUSPUPPET_SYNC_KEEP=3

# Refuse a tree that lost more than this share of its node files.
#
# A truncated fetch and a genuinely emptied estate look identical from the
# Puppet server, and installing the wrong one drops every node to default.yaml
# — an estate-wide declassification with no single log line to explain it. Set
# to 0 only when the estate really is shrinking that fast.
#NEXUSPUPPET_SYNC_MAX_SHRINK_PERCENT=50
